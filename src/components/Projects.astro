---
import { getCollection } from "astro:content";
import { formatDate } from "@/lib/util";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

type DescriptionLink = {
  text: string;
  href: string;
};

type DescriptionSegment =
  | string
  | {
      text: string;
      href: string;
    };

const createDescriptionSegments = (
  text: string,
  links: DescriptionLink[],
): DescriptionSegment[] => {
  const activeLinks = links.filter((link) => link.text.length > 0);

  if (activeLinks.length === 0) {
    return [text];
  }

  const segments: DescriptionSegment[] = [];
  let currentIndex = 0;

  while (currentIndex < text.length) {
    const nextMatch = activeLinks
      .map((link) => ({
        link,
        index: text.indexOf(link.text, currentIndex),
      }))
      .filter((match) => match.index !== -1)
      .sort((a, b) => a.index - b.index)[0];

    if (!nextMatch) {
      segments.push(text.slice(currentIndex));
      break;
    }

    if (nextMatch.index > currentIndex) {
      segments.push(text.slice(currentIndex, nextMatch.index));
    }

    segments.push({
      text: nextMatch.link.text,
      href: nextMatch.link.href,
    });
    currentIndex = nextMatch.index + nextMatch.link.text.length;
  }

  return segments;
};
---

<div class="mt-4 space-y-10">
  {
    projects.map((project) => {
      const {
        title,
        subtitle,
        description,
        descriptionLinks,
        technologies,
        href,
        date,
        image,
      } = project.data;
      const formattedDate = formatDate(date, {
        month: "long",
        year: "numeric",
        timeZone: "UTC",
      });
      const descriptionParagraphs = description
        .trim()
        .split(/\n\s*\n/)
        .filter(Boolean);
      return (
        <article class="space-y-4" {...{ key: project.id }}>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
              <a
                class="hover:underline"
                href={href}
                target="_blank"
                rel="noreferrer"
              >
                {title}
              </a>
            </h3>
            <time class="text-sm text-gray-600 dark:text-gray-400">{formattedDate}</time>
          </div>
          {technologies.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {technologies.map((tech) => (
                <li
                  class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-300"
                >
                  {tech}
                </li>
              ))}
            </ul>
          )}
          <p class="text-base font-medium text-gray-900 dark:text-white">{subtitle}</p>
          <div class="space-y-3 text-sm leading-relaxed text-gray-700 dark:text-gray-300">
            {descriptionParagraphs.map((paragraph, idx) => {
              const segments = createDescriptionSegments(paragraph, descriptionLinks);

              return (
                <p {...{ key: idx }}>
                  {segments.map((segment) =>
                    typeof segment === "string" ? (
                      segment
                    ) : (
                      <a
                        class="font-medium text-gray-900 underline underline-offset-2 hover:text-gray-600 dark:text-white dark:hover:text-gray-400"
                        href={segment.href}
                        target="_blank"
                        rel="noreferrer"
                      >
                        {segment.text}
                      </a>
                    ),
                  )}
                </p>
              );
            })}
          </div>
          {image && (
            <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800">
              <img
                src={image.src}
                alt={`${title} preview`}
                class="h-auto w-full object-contain"
                loading="lazy"
              />
            </div>
          )}
        </article>
      );
    })
  }
</div>
